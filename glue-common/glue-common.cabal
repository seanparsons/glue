cabal-version:      3.0
name:               glue-common
version:            0.7.0
synopsis:           Make better services and clients.
description:        Common types and base functions used in the glue family of libraries.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Sean Parsons
maintainer:         github@futurenotfound.com
category:           Network
build-type:         Simple
tested-with:        GHC == 9.6.7, GHC == 9.8.4, GHC == 9.10.3, GHC == 9.12.3

source-repository head
  type:     git
  location: https://github.com/seanparsons/glue.git

common common-options
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import:          common-options
  hs-source-dirs:  src
  exposed-modules: Glue.Types
  build-depends:
    , base                  >= 4.16 && < 5
    , hashable
    , unliftio              >= 0.2
    , unordered-containers

test-suite glue-common-tests
  import:             common-options
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  other-modules:
    Glue.TypesSpec
    Spec
  build-tool-depends: hspec-discover:hspec-discover
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -O2
  build-depends:
    , base                  >= 4.16 && < 5
    , glue-common
    , hashable
    , hspec
    , QuickCheck
    , quickcheck-instances
    , unliftio              >= 0.2
    , unordered-containers
