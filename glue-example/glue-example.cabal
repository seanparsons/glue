cabal-version:      3.0
name:               glue-example
version:            0.7.0.1
synopsis:           Make better services and clients.
description:        Examples of the use of glue library functionality.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Sean Parsons
maintainer:         github@futurenotfound.com
category:           Network
build-type:         Simple
tested-with:        GHC == 9.6.7, GHC == 9.8.4, GHC == 9.10.3, GHC == 9.12.3

source-repository head
  type:     git
  location: https://github.com/seanparsons/glue.git

common common-options
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

executable glue-example
  import:         common-options
  main-is:        Main.hs
  hs-source-dirs: src
  other-modules:  Glue.Example.BatcherExample
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  build-depends:
    , base                 >= 4.14 && < 5
    , ekg-core             >= 0.1  && < 0.2
    , glue-common          ^>= 0.7.0
    , glue-core            ^>= 0.7.0
    , glue-ekg             ^>= 0.7.0
    , text                 >= 1.2  && < 2.2
    , unliftio             >= 0.2  && < 0.3
    , unordered-containers >= 0.2  && < 0.3
