cabal-version:      3.0
name:               glue-ekg
version:            0.7.0.1
synopsis:           Make better services and clients.
description:        Glue library that makes use of ekg for providing stats around services and clients.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Sean Parsons
maintainer:         github@futurenotfound.com
category:           Network
build-type:         Simple
tested-with:        GHC == 9.6.7, GHC == 9.8.4, GHC == 9.10.3, GHC == 9.12.3

source-repository head
  type:     git
  location: https://github.com/seanparsons/glue.git

common common-options
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import:          common-options
  hs-source-dirs:  src
  exposed-modules: Glue.Ekg
  build-depends:
    , base        >= 4.14 && < 5
    , ekg-core    >= 0.1  && < 0.2
    , glue-common ^>= 0.7.0
    , text        >= 1.2  && < 2.2
    , time        >= 1.9  && < 1.15
    , unliftio    >= 0.2  && < 0.3

test-suite glue-ekg-tests
  import:             common-options
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  other-modules:
    Glue.EkgSpec
    Spec
  build-tool-depends: hspec-discover:hspec-discover
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  build-depends:
    , base                  >= 4.14 && < 5
    , ekg-core              >= 0.1  && < 0.2
    , glue-common           ^>= 0.7.0
    , glue-ekg
    , hspec                 >= 2.7  && < 2.12
    , QuickCheck            >= 2.14 && < 2.16
    , quickcheck-instances  >= 0.3  && < 0.4
    , text                  >= 1.2  && < 2.2
    , unliftio              >= 0.2  && < 0.3
    , unordered-containers  >= 0.2  && < 0.3
