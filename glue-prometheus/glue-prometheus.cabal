cabal-version:      3.0
name:               glue-prometheus
version:            0.8.0.0
synopsis:           Make better services and clients.
description:        Glue library that records Prometheus metrics for services and glue's combinators through prometheus-client.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Sean Parsons
maintainer:         github@futurenotfound.com
category:           Network
build-type:         Simple
extra-doc-files:    CHANGELOG.md
tested-with:        GHC == 9.6.7, GHC == 9.8.4, GHC == 9.10.3, GHC == 9.12.3

source-repository head
  type:     git
  location: https://github.com/seanparsons/glue.git

common common-options
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import:          common-options
  hs-source-dirs:  src
  exposed-modules: Glue.Prometheus
  build-depends:
    , base              >= 4.14 && < 5
    , bytestring        >= 0.10 && < 0.13
    , glue-common       ^>= 0.8.0
    , glue-core         ^>= 0.8.0
    , prometheus-client >= 1.1  && < 1.2
    , text              >= 1.2  && < 2.2
    , unliftio          >= 0.2  && < 0.3

test-suite glue-prometheus-tests
  import:             common-options
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  other-modules:
    Glue.PrometheusSpec
    Spec
  build-tool-depends: hspec-discover:hspec-discover
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  build-depends:
    , base              >= 4.14 && < 5
    , containers        >= 0.6  && < 0.8
    , glue-common       ^>= 0.8.0
    , glue-core         ^>= 0.8.0
    , glue-prometheus
    , hspec             >= 2.7  && < 2.12
    , prometheus-client >= 1.1  && < 1.2
    , text              >= 1.2  && < 2.2
    , unliftio          >= 0.2  && < 0.3
